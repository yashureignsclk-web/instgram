<script>
  let currentFilterString = "contrast(1.25) saturate(1.5) hue-rotate(15deg) brightness(0.95)";

  function setAspect(ratio, el) {
    const box = document.getElementById('viewport-box');
    const allBtns = document.querySelectorAll('.aspect-btn');
    allBtns.forEach(btn => {
      btn.classList.remove('bg-rose-600', 'text-white');
      btn.classList.add('text-slate-600');
    });
    el.classList.add('bg-rose-600', 'text-white');
    el.classList.remove('text-slate-600');

    if (ratio === '1/1') {
      box.style.aspectRatio = '1 / 1';
    } else if (ratio === '4/5') {
      box.style.aspectRatio = '4 / 5';
    } else if (ratio === '16/9') {
      box.style.aspectRatio = '16 / 9';
    }
  }

  function toggleZoom(btn) {
    const img = document.getElementById('main-preview-img');
    const grid = document.getElementById('crop-grid');
    const isZoomed = img.classList.contains('scale-125');

    if (isZoomed) {
      img.classList.remove('scale-125');
      btn.classList.remove('text-rose-600');
      grid.classList.remove('opacity-100');
      grid.classList.add('opacity-0');
    } else {
      img.classList.add('scale-125');
      btn.classList.add('text-rose-600');
      grid.classList.remove('opacity-0');
      grid.classList.add('opacity-100');
      setTimeout(() => {
        grid.classList.remove('opacity-100');
        grid.classList.add('opacity-0');
      }, 1500);
    }
  }

  function toggleMultiSelect(btn) {
    const isMulti = btn.classList.contains('bg-rose-600');
    if (isMulti) {
      btn.classList.remove('bg-rose-600', 'text-white');
      btn.classList.add('bg-white/90', 'text-slate-700');
    } else {
      btn.classList.remove('bg-white/90', 'text-slate-700');
      btn.classList.add('bg-rose-600', 'text-white');
    }
  }

  function selectFilter(name, cssFilter, btn) {
    document.querySelectorAll('.filter-item').forEach(item => {
      item.classList.remove('active-filter');
      const container = item.querySelector('div');
      container.className = 'w-16 h-16 rounded-xl overflow-hidden bg-white border border-[#e2e8f0] shadow-sm group-hover:scale-105 transition-all';
      const span = item.querySelector('span');
      span.className = 'font-label-sm text-[11px] text-[#1e293b] font-medium group-hover:text-slate-900 transition-colors';
    });

    btn.classList.add('active-filter');
    const activeCont = btn.querySelector('div');
    activeCont.className = 'w-16 h-16 rounded-xl overflow-hidden p-0.5 bg-gradient-to-tr from-amber-500 via-rose-500 to-purple-600 shadow-md group-hover:scale-105 transition-all';
    const activeSpan = btn.querySelector('span');
    activeSpan.className = 'font-label-sm text-[11px] text-rose-600 font-bold';

    currentFilterString = cssFilter;
    document.getElementById('active-filter-label').innerText = name;
    applyCombinedFilter();
  }

  function updateIntensity(val) {
    document.getElementById('intensity-val').innerText = val + '%';
    applyCombinedFilter(val / 100);
  }

  function applyCombinedFilter(intensity = 0.75) {
    const img = document.getElementById('main-preview-img');
    img.style.filter = `${currentFilterString} opacity(${0.5 + (intensity * 0.5)})`;
  }

  function triggerAICaption(btn) {
    const card = document.getElementById('ai-caption-card');
    card.classList.toggle('hidden');
    card.classList.toggle('flex');
  }

  function closeAICaption() {
    const card = document.getElementById('ai-caption-card');
    card.classList.add('hidden');
    card.classList.remove('flex');
  }

  function applyCaption() {
    const btn = document.querySelector('[onclick="triggerAICaption(this)"]');
    btn.innerHTML = `<span class="material-symbols-outlined text-[16px] text-emerald-600">check_circle</span><span>Caption Set</span>`;
    closeAICaption();
  }

  function regenerateCaption() {
    const quotes = [
      '"City neon washing over midnight memories. 🌃✨"',
      '"Between silence and static in Shibuya crossing. 🌧️"',
      '"Nocturne palette: 35mm reflections and street echoes. 🎞️"'
    ];
    const p = document.querySelector('#ai-caption-card p');
    p.innerText = quotes[Math.floor(Math.random() * quotes.length)];
  }

  function toggleAudioBadge(btn) {
    const label = document.getElementById('audio-label');
    if (label.innerText === 'Add Track') {
      label.innerText = 'Midnight City • M83';
      btn.classList.add('bg-slate-200', 'text-slate-900');
    } else {
      label.innerText = 'Add Track';
      btn.classList.remove('bg-slate-200', 'text-slate-900');
    }
  }

  function toggleTagState(btn) {
    const label = document.getElementById('tag-label');
    if (label.innerText.includes('0')) {
      label.innerText = 'Tagged (2)';
      btn.classList.add('bg-slate-200', 'text-slate-900');
    } else {
      label.innerText = 'Tag (0)';
      btn.classList.remove('bg-slate-200', 'text-slate-900');
    }
  }

  function switchPhoto(el) {
    const allThumbs = el.parentElement.children;
    for (let thumb of allThumbs) {
      thumb.classList.remove('ring-2', 'ring-rose-500', 'ring-offset-1');
      const badge = thumb.querySelector('.bg-rose-500');
      if (badge) badge.remove();
    }
    el.classList.add('ring-2', 'ring-rose-500', 'ring-offset-1');
    const badge = document.createElement('div');
    badge.className = 'absolute top-1 right-1 w-4 h-4 rounded-full bg-rose-500 flex items-center justify-center text-[10px] font-bold text-white shadow';
    badge.innerText = '1';
    el.appendChild(badge);

    const targetImg = el.querySelector('img');
    const previewImg = document.getElementById('main-preview-img');
    if (targetImg && previewImg) {
      previewImg.setAttribute('data-alt', targetImg.getAttribute('data-alt'));
    }
  }

  function toggleDrawer() {
    const drawer = document.querySelector('.rounded-t-3xl');
    drawer.classList.add('translate-y-1');
    setTimeout(() => drawer.classList.remove('translate-y-1'), 150);
  }
