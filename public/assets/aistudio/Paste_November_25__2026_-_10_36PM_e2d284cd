<script>
  // Format numeric values to compact or comma style
  function formatLikes(num) {
    if (num >= 10000) {
      const formatted = (num / 1000).toFixed(1);
      return formatted.endsWith('.0') ? formatted.slice(0, -2) + 'k' : formatted + 'k';
    }
    return num.toLocaleString();
  }

  // Like button micro-interaction
  function toggleLike(btn, countId, baseCount) {
    const isLiked = btn.getAttribute('data-liked') === 'true';
    const icon = btn.querySelector('.material-symbols-outlined');
    const particles = btn.parentElement.querySelector('.like-particles');
    const counterEl = document.getElementById(countId);

    // Remove any ongoing animation classes
    btn.classList.remove('animate-heart-pop');
    void btn.offsetWidth; // Force reflow

    if (isLiked) {
      // Unlike state
      btn.setAttribute('data-liked', 'false');
      btn.classList.remove('text-[#f43f5e]');
      btn.classList.add('text-slate-800');
      icon.style.fontVariationSettings = "'FILL' 0";
      icon.classList.remove('drop-shadow-[0_2px_8px_rgba(244,63,94,0.35)]');

      if (counterEl) {
        counterEl.classList.remove('count-anim-up', 'count-anim-down');
        void counterEl.offsetWidth;
        counterEl.classList.add('count-anim-down');
        counterEl.innerText = formatLikes(baseCount - 1);
      }
    } else {
      // Like state with pop bounce & particles
      btn.setAttribute('data-liked', 'true');
      btn.classList.remove('text-slate-800');
      btn.classList.add('text-[#f43f5e]', 'animate-heart-pop');
      icon.style.fontVariationSettings = "'FILL' 1";
      icon.classList.add('drop-shadow-[0_2px_8px_rgba(244,63,94,0.35)]');

      // Trigger particle burst
      if (particles) {
        particles.classList.remove('hidden');
        setTimeout(() => {
          particles.classList.add('hidden');
        }, 500);
      }

      if (counterEl) {
        counterEl.classList.remove('count-anim-up', 'count-anim-down');
        void counterEl.offsetWidth;
        counterEl.classList.add('count-anim-up');
        counterEl.innerText = formatLikes(baseCount + (baseCount === 8429 ? 1 : 1));
      }
    }
  }

  // Double tap to like on photo
  let lastTapTime = {};
  function handlePhotoTap(event, postId) {
    const now = Date.now();
    const last = lastTapTime[postId] || 0;
    const diff = now - last;
    lastTapTime[postId] = now;

    if (diff < 350 && diff > 0) {
      event.preventDefault();
      triggerPhotoLikeAnimation(postId);
    }
  }

  function triggerPhotoLikeAnimation(postId) {
    const container = document.getElementById('heart-burst-' + postId);
    if (!container) return;
    const heartIcon = container.querySelector('.material-symbols-outlined');
    if (!heartIcon) return;

    heartIcon.classList.remove('hidden', 'double-tap-anim');
    void heartIcon.offsetWidth; // Reflow
    heartIcon.classList.add('double-tap-anim');

    setTimeout(() => {
      heartIcon.classList.add('hidden');
      heartIcon.classList.remove('double-tap-anim');
    }, 850);

    // Also trigger like button if not already liked
    const postElem = document.getElementById(postId);
    if (postElem) {
      const likeBtn = postElem.querySelector('.like-button');
      if (likeBtn && likeBtn.getAttribute('data-liked') === 'false') {
        const countId = postId === 'post-marcus' ? 'like-count-1' : 'like-count-2';
        const baseNum = postId === 'post-marcus' ? 8429 : 18200;
        toggleLike(likeBtn, countId, baseNum);
      }
    }
  }

  // Bookmark toggle with elastic squash-and-stretch and Toast Notification
  function toggleBookmark(btn) {
    const icon = btn.querySelector('.material-symbols-outlined');
    const isSaved = icon.innerText === 'bookmark';

    btn.classList.remove('animate-bookmark-bounce');
    void btn.offsetWidth; // Reflow
    btn.classList.add('animate-bookmark-bounce');

    if (isSaved) {
      icon.innerText = 'bookmark_border';
      btn.classList.remove('text-slate-950');
      btn.classList.add('text-slate-700');
      showToast('Removed from Collection', 'bookmark_border');
    } else {
      icon.innerText = 'bookmark';
      btn.classList.remove('text-slate-700');
      btn.classList.add('text-slate-950');
      showToast('Saved to Collection', 'bookmark');
    }
  }

  // Toast Notification helper
  let toastTimeout;
  function showToast(message, iconName = 'info') {
    const toast = document.getElementById('app-toast');
    const text = document.getElementById('toast-text');
    const icon = document.getElementById('toast-icon');
    if (!toast) return;

    text.innerText = message;
    icon.innerText = iconName;

    clearTimeout(toastTimeout);
    toast.classList.remove('opacity-0', '-translate-y-4');
    toast.classList.add('opacity-100', 'translate-y-0');

    toastTimeout = setTimeout(() => {
      toast.classList.remove('opacity-100', 'translate-y-0');
      toast.classList.add('opacity-0', '-translate-y-4');
    }, 2400);
  }

  // Audio pill toggle
  let isAudioPlaying = true;
  function toggleAudio(event) {
    event.stopPropagation();
    const bars = document.querySelectorAll('#soundwave-bars span');
    const icon = document.getElementById('audio-icon');
    const statusTag = document.getElementById('audio-status-tag');

    isAudioPlaying = !isAudioPlaying;

    if (isAudioPlaying) {
      bars.forEach(b => b.classList.remove('bar-paused'));
      icon.innerText = 'graphic_eq';
      statusTag.innerText = 'Playing';
      showToast('Audio playing · ODESZA', 'music_note');
    } else {
      bars.forEach(b => b.classList.add('bar-paused'));
      icon.innerText = 'volume_off';
      statusTag.innerText = 'Paused';
      showToast('Audio muted', 'volume_off');
    }
  }
