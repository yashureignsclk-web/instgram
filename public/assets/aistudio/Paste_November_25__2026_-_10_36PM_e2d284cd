<!-- Interactive Logic -->
<script>
    let currentStep = 1;
    const totalSteps = 4;

    function updateStepUI() {
      // Hide all steps
      for (let i = 1; i <= totalSteps; i++) {
        const stepEl = document.getElementById(`step${i}`);
        const barEl = document.getElementById(`bar-${i}`);
        if (stepEl) stepEl.classList.add('hidden');
        if (barEl) {
          if (i <= currentStep) {
            barEl.className = 'h-1.5 flex-1 rounded-full gradient-lumina transition-all duration-300';
          } else {
            barEl.className = 'h-1.5 flex-1 rounded-full bg-slate-200 transition-all duration-300';
          }
        }
      }

      // Show current step
      const activeStep = document.getElementById(`step${currentStep}`);
      if (activeStep) activeStep.classList.remove('hidden');

      // Update counter
      document.getElementById('stepCounter').innerText = `${currentStep}/${totalSteps}`;

      // Update button text
      const nextBtnText = document.getElementById('nextBtnText');
      const loginPrompt = document.getElementById('loginPrompt');
      const prevBtn = document.getElementById('prevBtn');

      if (currentStep === 1) {
        prevBtn.style.opacity = '0.3';
        prevBtn.style.pointerEvents = 'none';
        nextBtnText.innerText = 'Continue to Profile';
        loginPrompt.classList.remove('hidden');
      } else {
        prevBtn.style.opacity = '1';
        prevBtn.style.pointerEvents = 'auto';
        loginPrompt.classList.add('hidden');

        if (currentStep === 2) {
          nextBtnText.innerText = 'Select Aesthetics';
        } else if (currentStep === 3) {
          nextBtnText.innerText = 'Discover Curators';
        } else if (currentStep === 4) {
          nextBtnText.innerText = 'Enter Lumina Feed';
        }
      }
    }

    function handleNext() {
      if (currentStep < totalSteps) {
        currentStep++;
        updateStepUI();
      } else {
        // Final completion state
        const btn = document.getElementById('nextBtn');
        btn.innerHTML = `
          <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          Setting up your feed...
        `;
        setTimeout(() => {
          btn.classList.remove('gradient-lumina');
          btn.classList.add('bg-emerald-600');
          btn.innerHTML = `
            <svg class="w-4 h-4 text-white mr-1.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg>
            Welcome to Lumina!
          `;
        }, 1200);
      }
    }

    function handleBack() {
      if (currentStep > 1) {
        currentStep--;
        updateStepUI();
      }
    }

    function toggleTag(card) {
      const isSelected = card.classList.contains('border-rose-500');
      const icon = card.querySelector('div.w-5');
      if (isSelected) {
        card.classList.remove('border-rose-500', 'bg-rose-50/50');
        card.classList.add('border-slate-200', 'bg-white');
        icon.className = 'w-5 h-5 rounded-full border border-slate-300 text-transparent flex items-center justify-center shrink-0';
      } else {
        card.classList.remove('border-slate-200', 'bg-white');
        card.classList.add('border-rose-500', 'bg-rose-50/50');
        icon.className = 'w-5 h-5 rounded-full gradient-lumina text-white flex items-center justify-center shrink-0';
      }
    }

    function toggleFollow(btn) {
      if (btn.innerText === 'Follow') {
        btn.innerText = 'Following';
        btn.className = 'px-4 py-1.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700 hover:bg-slate-200 transition';
      } else {
        btn.innerText = 'Follow';
        btn.className = 'px-4 py-1.5 rounded-full text-xs font-bold gradient-lumina text-white shadow-sm hover:opacity-95 active:scale-95 transition';
      }
    }

    function followAll() {
      const buttons = document.querySelectorAll('#step4 button');
      buttons.forEach(b => {
        if (b.innerText === 'Follow') {
          toggleFollow(b);
        }
      });
    }

    // Initialize UI on load
    updateStepUI();
  </script>
</body>
</html>


