<!-- Interactive JavaScript for Profile Interactions -->
<script>
    (function initProfileMicroInteractions() {
      // Tab switching logic
      const tabs = document.querySelectorAll('.profile-tab');
      const contents = document.querySelectorAll('.tab-content');

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const targetId = tab.getAttribute('data-target');
          
          // Reset tabs styling
          tabs.forEach(t => {
            t.classList.remove('text-primary');
            t.classList.add('text-on-surface-variant');
            const ind = t.querySelector('.tab-indicator');
            if (ind) ind.classList.add('hidden');
          });

          // Activate clicked tab
          tab.classList.remove('text-on-surface-variant');
          tab.classList.add('text-primary');
          const indicator = tab.querySelector('.tab-indicator');
          if (indicator) indicator.classList.remove('hidden');

          // Toggle content panels
          contents.forEach(content => {
            if (content.id === targetId) {
              content.classList.remove('hidden');
            } else {
              content.classList.add('hidden');
            }
          });
        });
      });

      // Mobile Touch Toggle for Post Metric Overlays
      const postItems = document.querySelectorAll('.post-item');
      postItems.forEach(post => {
        post.addEventListener('click', (e) => {
          const overlay = post.querySelector('.overlay-metrics');
          if (overlay) {
            const isVisible = overlay.classList.contains('opacity-100');
            // Dismiss all others first
            document.querySelectorAll('.overlay-metrics').forEach(ov => ov.classList.remove('opacity-100'));
            if (!isVisible) {
              overlay.classList.add('opacity-100');
            }
          }
        });
      });
